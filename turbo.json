{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "dependsOn": [
        "^build",
        "build"
      ]
    },
    "lint": {},
    "dev": {
      "cache": false,
      "persistent": true
    },
    "//#registry:build": {
      "inputs": [
        "scripts/build-registry.ts",
        "registry/registry.json",
        "packages/core/src/**",
        "packages/react/src/**"
      ],
      "outputs": [
        "registry/dist/**"
      ]
    },
    "novaui#build": {
      "dependsOn": [
        "^build",
        "//#registry:build"
      ],
      "outputs": [
        "dist/**",
        "registry/**"
      ]
    },
    "@nova-ui/docs#test": {
      "dependsOn": [
        "^build"
      ]
    }
  }
}
