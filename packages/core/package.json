{
  "name": "@nova-ui/core",
  "version": "0.1.0",
  "description": "Moteurs d'animation framework-agnostiques de Nova. TypeScript, sans d\u00e9pendance sauf l\u00e0 o\u00f9 une librairie ach\u00e8te vraiment quelque chose.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./expand": {
      "types": "./dist/engines/expand.d.ts",
      "import": "./dist/engines/expand.js",
      "require": "./dist/engines/expand.cjs"
    },
    "./smooth-scroll": {
      "types": "./dist/engines/smooth-scroll.d.ts",
      "import": "./dist/engines/smooth-scroll.js",
      "require": "./dist/engines/smooth-scroll.cjs"
    },
    "./styles.css": "./dist/nova.css",
    "./bloom": {
      "types": "./dist/engines/bloom.d.ts",
      "import": "./dist/engines/bloom.js",
      "require": "./dist/engines/bloom.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "jsdom": "^25.0.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26"
  },
  "peerDependencies": {
    "gsap": ">=3.13",
    "lenis": ">=1.3"
  },
  "peerDependenciesMeta": {
    "gsap": {
      "optional": true
    },
    "lenis": {
      "optional": true
    }
  }
}
