{
  "name": "@nova-ui/react",
  "version": "0.1.0",
  "description": "Composants React de Nova, bâtis sur @nova-ui/core.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup && node scripts/add-use-client.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@nova-ui/core": "workspace:*",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  },
  "peerDependencies": {
    "radix-ui": ">=1.4",
    "react": ">=18",
    "react-day-picker": ">=9"
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.0.2",
    "gsap": "^3.15.0",
    "jsdom": "^25.0.1",
    "radix-ui": "^1.6.7",
    "react": "^19.0.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "peerDependenciesMeta": {
    "radix-ui": {
      "optional": true
    },
    "react": {
      "optional": false
    },
    "react-day-picker": {
      "optional": true
    }
  }
}
